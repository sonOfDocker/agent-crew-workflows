# OpenAI
# Add your OpenAI API key when using OpenAI-backed agents.
OPENAI_API_KEY=

# Anthropic
# Add your Anthropic API key if using Claude-backed agents.
ANTHROPIC_API_KEY=

# Serper
# Add a Serper API key if enabling web search tools for agents.
SERPER_API_KEY=

# CrewAI
# Default model configuration can be adjusted as the project evolves.
CREWAI_DEFAULT_MODEL=gpt-4o-mini

# Project Paths
# Example paths for future scripts or local workflow runners.
# These files may not exist until example workflow assets are added.
PROJECT_ROOT=.
CONTEXT_BUNDLE_PATH=examples/context-bundle.example.md
STORY_INPUT_PATH=examples/stories/example-story.md

# Runtime Settings
# Set to development, test, or production as needed.
AGENT_CREW_ENV=development

# Logging
# Supported examples: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Set to true only when enabling live tool/API-backed agent runs.
ENABLE_LIVE_AGENT_TOOLS=false